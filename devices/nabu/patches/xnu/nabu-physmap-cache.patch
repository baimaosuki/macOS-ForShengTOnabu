@@ -1983,15 +1983,23 @@
 	ptov_table_entry temp_ptov_table[PTOV_TABLE_SIZE];
 	bzero(temp_ptov_table, sizeof(temp_ptov_table));
 
+#if __ARM_PTE_PHYSMAP__
+	/* The cache updater addresses one4K leaf and rejects contiguous hints.
+	 * Block/hinted WB aperture aliases conflict with NC BO mappings. */
+	const unsigned aperture_granule = 0;
