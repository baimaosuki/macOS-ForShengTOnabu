+#if defined(NABU)
+/* Transfer only the physical console. console_write captures RAM/ESP logging
+ * before disableConsoleOutput, so no filesystem/transport is used here.
+ */
+void
+nabu_console_claim_framebuffer(void)
+{
+    simple_lock(&vc_progress_lock, LCK_GRP_NULL);
+    VCPUTC_LOCK_LOCK();
+    __atomic_store_n(&nabu_console_framebuffer_owned, TRUE, __ATOMIC_RELEASE);
+    gc_enabled = FALSE;
+    disableConsoleOutput = TRUE;
+    VCPUTC_LOCK_UNLOCK();
+    simple_unlock(&vc_progress_lock);
+}
+
+/* Panic has stopped normal presentation. Never wait for another CPU's
+ * console lock here; the freestanding panic screen also retains direct GOP.
+ */
+void
+nabu_console_panic_takeover(void)
+{
+    __atomic_store_n(&nabu_console_framebuffer_owned, FALSE, __ATOMIC_RELEASE);
+    gc_enabled = TRUE;
+    disableConsoleOutput = FALSE;
+}
