+/* SHENG's exit() trace misses fatal signals. Capture the real aborting
+ * thread before corpse creation; never change the signal/restart policy. */
+__attribute__((noinline)) static void
+nabu_windowserver_abort_context(proc_t p, int rv)
+{
+	static _Atomic unsigned captured;
+	int signal = WTERMSIG(rv);
+	if (p != current_proc() ||
+	    (signal != SIGABRT && signal != SIGSEGV && signal != SIGBUS && signal != SIGILL) ||
+	    strcmp(p->p_name, "WindowServer") != 0) return;
+	unsigned slot = atomic_load_explicit(&captured, memory_order_relaxed);
+	do {
+		if (slot >= 3) return;
+	} while (!atomic_compare_exchange_weak_explicit(&captured, &slot, slot + 1,
+	    memory_order_relaxed, memory_order_relaxed));
+	char *description = exit_reason_get_string_desc(p->p_exit_reason);
+	printf("NABU-WS-ABORT: capture=%u/3 namespace=%u code=0x%llx description=%.256s\n",
+	    slot + 1, p->p_exit_reason ? p->p_exit_reason->osr_namespace : 0,
+	    p->p_exit_reason ? p->p_exit_reason->osr_code : 0,
+	    description ? description : "none");
+	nabu_critical_user_context(p, rv);
+}
 #endif
 
