@@ -532,6 +536,10 @@
 void
 console_write(char *str, int size)
 {
+#if NABU_ARM64E_COMPAT
+	/* RAM only, once at input; never wait behind a stopped console CPU. */
+	if (str != NULL && size > 0) nabu_capture_append(str, (unsigned)size);
