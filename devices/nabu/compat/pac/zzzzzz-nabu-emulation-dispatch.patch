--- a/osfmk/arm64/nabu_gpr_fast.h
+++ b/osfmk/arm64/nabu_gpr_fast.h
@@ -0,0 +1,34 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+#ifndef NABU_GPR_FAST_H
+#define NABU_GPR_FAST_H
+/* Included after arm_saved_state64_t and nabu_nopac.h. No SIMD, logging,
+ * allocation or lock; unsupported/memory opcodes retain the full slow path.
+ * This optimizes C dispatch, not the assembly vector context spill. */
+static inline uint64_t nabu_gpr_get(const arm_saved_state64_t *s, unsigned r) {
+    return r < 29 ? s->x[r] : r == 29 ? s->fp : r == 30 ? s->lr : 0;
+}
+static inline void nabu_gpr_put(arm_saved_state64_t *s, unsigned r, uint64_t v) {
+    if (r < 29) s->x[r] = v; else if (r == 29) s->fp = v; else if (r == 30) s->lr = v;
+}
+static inline bool nabu_gpr_fast_step(arm_saved_state64_t *s, uint32_t op, bool user) {
+    unsigned rd=op&31U, rn=(op>>5)&31U;
+    uint64_t next=s->pc+4;
+    if ((op&0xffff8000U)==0xdac10000U) {
+        unsigned opc=(op>>10)&31U;
+        if (opc>17U || (opc>=8U && rn!=31U)) return false;
+        if (rd!=31U && opc>=4U && (opc<8U || opc>=12U)) {
+            bool data=opc==6U || opc==7U || opc==14U || opc==15U || opc==17U;
+            nabu_gpr_put(s,rd,nabu_nopac_authenticate(nabu_gpr_get(s,rd),user,data));
+        }
+    } else if (op==0xd65f0bffU || op==0xd65f0fffU) {
+        next=nabu_nopac_canonical(s->lr,user);
+    } else if (nabu_nopac_opcode(op) && (op&0xff200400U)!=0xf8200400U) {
+        if (rn==31U) return false;
+        next=nabu_nopac_canonical(nabu_gpr_get(s,rn),user);
+        if (op&0x00200000U) s->lr=s->pc+4;
+    } else return false;
+    s->pc=next;
+    s->cpsr &= ~(1U<<21);
+    return true;
+}
+#endif
