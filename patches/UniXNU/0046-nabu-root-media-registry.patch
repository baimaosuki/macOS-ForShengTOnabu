+static void captureMissingMedia (const char *uuid, NativeUfsBlock *window)
+{
+  IOService *resources = IOService::getResourceService ();
+  OSObject *ioBSD = resources ? resources->copyProperty ("IOBSD") : nullptr;
+  int used = snprintf (gRootMediaText, sizeof (gRootMediaText),
+    "Waiting for %.36s IOBSD=%u state=%x busy=%u\n", uuid, ioBSD ? 1U : 0U,
+    resources ? resources->getState () : 0U, resources ? resources->getBusyState () : 0U);
+  OSSafeReleaseNULL (ioBSD);
+  IORegistryIterator *iterator = IORegistryIterator::iterateOver (
+    window, gIOServicePlane, kIORegistryIterateRecursively);
+  unsigned count = 0;
+  bool complete = false;
+  while (iterator) {
+    IORegistryEntry *entry = iterator->getNextObject ();
+    if (!entry) { complete = true; break; }
+    if (count == 64) break;
+    ++count;
+    IOService *service = OSDynamicCast (IOService, entry);
+    IOService *provider = service ? service->getProvider () : nullptr;
+    OSObject *identity = entry->copyProperty ("UUID");
+    OSObject *name = entry->copyProperty (kIOBSDNameKey);
+    OSObject *contents = entry->copyProperty ("Content");
+    OSString *id = OSDynamicCast (OSString, identity);
+    OSString *bsd = OSDynamicCast (OSString, name);
+    OSString *content = OSDynamicCast (OSString, contents);
+    const char *className = entry->getMetaClass ()->getClassName ();
+    const char *parentClass = provider ? provider->getMetaClass ()->getClassName () : "-";
+    IOLog ("NativeUfs tree: id=%llx name=%.32s class=%.40s parent=%llx/%.40s state=%x busy=%u uuid=%.36s bsd=%.24s content=%.40s\n",
+      static_cast<unsigned long long> (entry->getRegistryEntryID ()), entry->getName (), className,
+      provider ? static_cast<unsigned long long> (provider->getRegistryEntryID ()) : 0ULL, parentClass,
+      service ? service->getState () : 0U, service ? service->getBusyState () : 0U,
+      id ? id->getCStringNoCopy () : "-", bsd ? bsd->getCStringNoCopy () : "-",
+      content ? content->getCStringNoCopy () : "-");
+    // Keep the panic page bounded; reserve detailed identity rows for media.
+    // Non-media services still identify where an unfinished driver is attached.
+    if (used < int (sizeof (gRootMediaText)) - 180) {
+      used += snprintf (gRootMediaText + used, sizeof (gRootMediaText) - used,
+        "%.28s state=%x busy=%u\n", className,
+        service ? service->getState () : 0U, service ? service->getBusyState () : 0U);
+      if (service && service->metaCast ("IOMedia")) {
+        used += snprintf (gRootMediaText + used, sizeof (gRootMediaText) - used,
+          " bsd=%.16s uuid=%.36s\n content=%.36s\n",
+          bsd ? bsd->getCStringNoCopy () : "-", id ? id->getCStringNoCopy () : "-",
+          content ? content->getCStringNoCopy () : "-");
       }
-      iterator->release ();
-    }
-  }
-  OSSafeReleaseNULL (wanted);
-  OSSafeReleaseNULL (properties);
-  OSSafeReleaseNULL (matching);
-  return found;
-}
