+// Registry traversal sees attached services even while their matching thread
+// is running. Identity comes exclusively from existing APFS volume properties.
+struct NabuRootMediaRegistry {
+  IORegistryIterator *iterator;
+  const char *uuid;
+  IORegistryEntry *next () { return iterator->getNextObject (); }
+  bool valid () { return iterator->isValid (); }
+  NabuRootMediaView view (IORegistryEntry *entry) {
+    NabuRootMediaView value;
+    IOService *media = OSDynamicCast (IOService, entry);
+    if (!media || !media->metaCast ("IOMedia")) return value;
+    value.media = value.inWindow = true; // Iterator is rooted at this window.
+    const IOOptionBits state = media->getState ();
+    value.registered = state & kIOServiceRegisteredState;
+    value.inactive = state & kIOServiceInactiveState;
+    // 25F71 AppleAPFSVolume::MetaClass::alloc calls IOMediaC2 directly;
+    // vfs_exclave_fs_helper.cpp also names this class as APFS_VOLUME_OBJECT.
+    // A container/scheme alone must never satisfy this volume gate.
+    value.volume = media->metaCast ("AppleAPFSVolume") != nullptr;
+    OSObject *whole = media->copyProperty ("Whole");
+    value.whole = whole != kOSBooleanFalse; // Missing/type-invalid fails closed.
+    OSSafeReleaseNULL (whole);
+    OSObject *identity = media->copyProperty ("UUID");
+    OSString *id = OSDynamicCast (OSString, identity);
+    value.uuidMatches = id && id->isEqualTo (uuid);
+    OSSafeReleaseNULL (identity);
+    OSObject *name = media->copyProperty (kIOBSDNameKey);
+    OSString *bsd = OSDynamicCast (OSString, name);
+    value.bsdName = bsd && bsd->getLength ();
+    OSSafeReleaseNULL (name);
+    OSObject *major = media->copyProperty (kIOBSDMajorKey);
+    OSObject *minor = media->copyProperty (kIOBSDMinorKey);
+    value.bsdMajor = OSDynamicCast (OSNumber, major) != nullptr;
+    value.bsdMinor = OSDynamicCast (OSNumber, minor) != nullptr;
+    OSSafeReleaseNULL (major);
+    OSSafeReleaseNULL (minor);
+    return value;
+  }
+};
