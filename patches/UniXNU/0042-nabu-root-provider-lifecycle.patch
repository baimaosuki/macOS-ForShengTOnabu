+static bool nabuRootProvider (IOService *provider)
+{
+  if (!OSDynamicCast (IOPlatformDevice, provider)) return false;
+  NabuUfsResources resources = {};
+  struct Field { const char *key; void *out; unsigned bytes; };
+  Field fields[] = {
+    { "nabu,ufs-hc", resources.hc, sizeof (resources.hc) },
+    { "nabu,ufs-gcc", resources.gcc, sizeof (resources.gcc) },
+    { "nabu,ufs-smmu", resources.smmu, sizeof (resources.smmu) },
+    { "nabu,ufs-stream", &resources.stream, sizeof (resources.stream) },
+    { "nabu,ufs-block-bytes", &resources.blockBytes, sizeof (resources.blockBytes) },
+  };
+  for (const Field &field : fields) {
+    OSData *data = OSDynamicCast (OSData, provider->getProperty (field.key));
+    if (!data || data->getLength () != field.bytes || !data->getBytesNoCopy ()) return false;
+    memcpy (field.out, data->getBytesNoCopy (), field.bytes);
+  }
+  if (!nabuUfsResourcesMatch (resources)) return false;
+  OSSharedPtr<IOMemoryMap> clockMap;
+  uintptr_t gcc = mapPhys (resources.gcc[0], resources.gcc[1], clockMap);
+  if (!gcc) return false;
+  const auto &board = nabu_ufs::kBoard;
+  uint32_t gdsc = read32 (gcc, board.gdscr - 0x77000);
+  uint32_t axi = read32 (gcc, board.axiEnable - 0x77000);
+  uint32_t ahb = read32 (gcc, board.ahbEnable - 0x77000);
+  IOLog ("NABU UFS provider hc=%llx bytes=%llx stream=%x gdsc=%08x axi=%08x ahb=%08x\n",
+         static_cast<unsigned long long> (resources.hc[0]),
+         static_cast<unsigned long long> (resources.hc[1]), resources.stream, gdsc, axi, ahb);
+  return nabuUfsClocksReady (gdsc, axi, ahb);
+}
