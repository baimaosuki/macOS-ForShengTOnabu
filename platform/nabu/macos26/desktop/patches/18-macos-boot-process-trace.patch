Explicit opt-in bounded boot process exec/exit diagnostics; no behavior overrides.
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -945,6 +945,208 @@
 		p->p_crash_behavior |= POSIX_SPAWN_PANIC_ON_SPAWN_FAIL;
