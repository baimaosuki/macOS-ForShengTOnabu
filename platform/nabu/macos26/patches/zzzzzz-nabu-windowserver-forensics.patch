Opt-in WindowServer entry context in the ESP RAM journal, before exit teardown and exception delivery.
--- a/bsd/kern/kern_exit.c
+++ b/bsd/kern/kern_exit.c
@@ -138,6 +138,10 @@
 #include <os/system_event_log.h>
 
 #include <pexpert/pexpert.h>
+
+#if defined(NABU) && NABU && defined(__arm64__)
+#include "nabu_windowserver_trace.h"
+#endif
 #if SHENG
 extern void sheng_windowserver_stop(unsigned exception, uint64_t code, uint64_t subcode);
 #endif
@@ -1719,6 +1723,9 @@
 void
 exit(proc_t p, struct exit_args *uap, int *retval)
 {
+#if defined(NABU) && NABU && defined(__arm64__)
+	nabu_ws_trace_context("exit-syscall", (uint32_t)uap->rval, 0, 0);
+#endif
 	p->p_xhighbits = ((uint32_t)(uap->rval) & 0xFF000000) >> 24;
 	exit1(p, W_EXITCODE((uint32_t)uap->rval, 0), retval);
 
@@ -1760,6 +1767,13 @@
 	struct uthread *ut;
 	int error = 0;
 	bool proc_exiting = false;
+
+#if defined(NABU) && NABU && defined(__arm64__)
+	if (p == current_proc())
+		nabu_ws_trace_context("exit-with-reason", (uint32_t)rv,
+		    exit_reason ? exit_reason->osr_code : 0,
+		    exit_reason ? exit_reason->osr_namespace : 0);
+#endif
 
 #if DEVELOPMENT || DEBUG
 	/*
--- a/osfmk/kern/exception.c
+++ b/osfmk/kern/exception.c
@@ -94,6 +94,20 @@
 #include <string.h>
 
 #include <pexpert/pexpert.h>
+
+#if defined(NABU) && NABU && defined(__arm64__)
+#include "nabu_windowserver_trace.h"
+#include <vm/vm_shared_region_xnu.h>
+uint64_t
+nabu_ws_trace_slide(void)
+{
+	vm_shared_region_t region = vm_shared_region_get(current_task());
+	if (!region) return UINT64_MAX;
+	uint64_t slide = region->sr_slide;
+	vm_shared_region_deallocate(region);
+	return slide;
+}
+#endif
 
 #include <os/log.h>
 #include <os/system_event_log.h>
@@ -990,6 +994,9 @@
 	task_t   task   = current_task();
 
 	assert(codeCnt > 0);
+#if defined(NABU) && NABU && defined(__arm64__)
+	nabu_ws_trace_context("exception", (unsigned)exception, code[0], codeCnt > 1 ? code[1] : 0);
+#endif
 #if SHENG && defined(MACH_BSD)
 	sheng_windowserver_stop((unsigned)exception, code[0], codeCnt > 1 ? code[1] : 0);
 #endif
