+#define CPC_READ_SLOT(reg)                  (0ULL)
+#else
+#define CPC_READ_PMCR0()                    __builtin_arm_rsr64("S3_1_C15_C0_0")
+#define CPC_READ_UPMCR()                    __builtin_arm_rsr64("S3_7_C15_C6_4")
+#define CPC_WRITE_SLOT(reg, value)          __builtin_arm_wsr64(reg, value)
+#define CPC_READ_SLOT(reg)                  __builtin_arm_rsr64(reg)
+#endif
+#endif
