+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+#ifndef NABU_NOPAC_H
+#define NABU_NOPAC_H
+#include <stdint.h>
+#include <stdbool.h>
+/* No keys or signed-pointer ABI are claimed. PAC leaves Xd intact, AUT/XPAC
+ * restore address bits, authenticated control flow uses that plain address.
+ * The caller copies this frame back only on success, including successful loads.
+ */
+struct nabu_nopac_frame { uint64_t x[31], sp, pc; };
+typedef bool (*nabu_nopac_read_t)(uint64_t, uint64_t *, void *);
+static inline uint64_t
+nabu_nopac_canonical(uint64_t value, bool user)
+{
+    uint64_t plain = value & UINT64_C(0x0000ffffffffffff);
+    return !user && (plain & (UINT64_C(1) << 47)) ? plain | UINT64_C(0xffff000000000000) : plain;
+}
+static inline bool
+nabu_nopac_opcode(uint32_t op)
+{
+    return (op & 0xffff8000U) == 0xdac10000U || op == 0xd65f0bffU || op == 0xd65f0fffU ||
+        (op & 0xfffffc00U) == 0xd71f0800U || (op & 0xfffffc00U) == 0xd71f0c00U ||
+        (op & 0xfffffc00U) == 0xd73f0800U || (op & 0xfffffc00U) == 0xd73f0c00U ||
+        (op & 0xfffffc1fU) == 0xd61f081fU || (op & 0xfffffc1fU) == 0xd61f0c1fU ||
+        (op & 0xfffffc1fU) == 0xd63f081fU || (op & 0xfffffc1fU) == 0xd63f0c1fU ||
+        (op & 0xff200400U) == 0xf8200400U;
+}
+static inline bool
+nabu_nopac_step(struct nabu_nopac_frame *f, uint32_t op, bool user,
+    nabu_nopac_read_t read64, void *context)
+{
+    unsigned rd = op & 31U, rn = (op >> 5) & 31U;
+    uint64_t pc = f->pc;
+    if ((op & 0xffff8000U) == 0xdac10000U) {
+        unsigned opc = (op >> 10) & 31U;
+        if (opc > 17U || (opc >= 8U && rn != 31U)) return false;
+        if (rd != 31U && (opc >= 4U && (opc < 8U || opc >= 12U))) f->x[rd] = nabu_nopac_canonical(f->x[rd], user);
+        f->pc = pc + 4;
+        return true;
+    }
+    if (op == 0xd65f0bffU || op == 0xd65f0fffU) {
+        f->pc = nabu_nopac_canonical(f->x[30], user);
+        return true;
+    }
+    if ((op & 0xff200400U) == 0xf8200400U) {
+        unsigned wb = (op >> 11) & 1U, sign = (op >> 22) & 1U;
+        int64_t imm = (int64_t)((sign << 9) | ((op >> 12) & 511U)) - (sign ? 1024 : 0);
+        if (wb && rd == rn && rd != 31U) return false;
+        uint64_t base = rn == 31U ? f->sp : f->x[rn];
+        uint64_t address = nabu_nopac_canonical(base, user) + (uint64_t)(imm * 8);
+        uint64_t value;
+        if (!read64 || !read64(address, &value, context)) return false;
+        if (rd != 31U) f->x[rd] = value; /* Loaded data is not an address. */
+        if (wb) { if (rn == 31U) f->sp = address; else f->x[rn] = address; }
+        f->pc = pc + 4;
+        return true;
+    }
+    if (nabu_nopac_opcode(op)) {
+        if (rn == 31U) return false; /* branch target X31 is reserved */
+        uint64_t target = nabu_nopac_canonical(f->x[rn], user);
+        bool link = (op & 0x00200000U) != 0;
+        if (link) f->x[30] = pc + 4; /* capture target before changing LR */
+        f->pc = target;
+        return true;
+    }
+    return false;
+}
+#endif
