-	    (uint32_t)mr_lp, (uint32_t)(dc_rn >> 32), mr);
+#if defined(NABU) && NABU
+	nabu_session_ipc_end(&nabu_call, mr);
+#endif
 	/* unblock call is idempotent */
 	ipc_port_thread_group_unblocked();
 	return mr;
