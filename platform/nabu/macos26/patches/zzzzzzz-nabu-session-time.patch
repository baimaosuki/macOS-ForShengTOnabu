Correct 19.2 MHz microtime, initialize the boot calendar and trace identity/session IPC to ESP RAM.
--- a/osfmk/arm/rtclock.c
+++ b/osfmk/arm/rtclock.c
@@ -468,7 +468,7 @@
 	*secs = t64 = abstime / rtclock_sec_divisor;
 	abstime -= (t64 * rtclock_sec_divisor);
 
-	*microsecs = (uint32_t)(abstime / rtclock_usec_divisor);
+	*microsecs = (uint32_t)((abstime * USEC_PER_SEC) / rtclock_sec_divisor);
 }
 
 void
--- a/bsd/kern/kern_time.c
+++ b/bsd/kern/kern_time.c
@@ -255,6 +255,18 @@
 	 * is gotten from the calendar.
 	 */
 	microtime(&tv);
+#if defined(NABU) && NABU
+#include "nabu_boot_epoch.h"
+	/* No board RTC yet. Preserve a valid platform clock; otherwise use the
+	 * build's recorded UTC floor, as SHENG's platform calendar does. */
+	if (tv.tv_sec < (time_t)NABU_BUILD_EPOCH) {
+		tv.tv_sec = (time_t)NABU_BUILD_EPOCH;
+		tv.tv_usec = 0;
+		setthetime(&tv);
+		printf("NABU calendar: build UTC floor=%llu applied (RTC unavailable or older)\n",
+		    (unsigned long long)NABU_BUILD_EPOCH);
+	}
+#endif
 
 	if (tv.tv_sec < 0 || tv.tv_usec < 0) {
 		printf("WARNING: preposterous time in Real Time Clock");
