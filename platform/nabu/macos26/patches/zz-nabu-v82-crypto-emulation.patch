+ * SPDX-License-Identifier: MIT
+ *
+ * nabu_v82_emul.h -- ARMv8.2-A cryptography instruction emulation for
+ * boards whose CPU implements ARMv8.2-A without FEAT_SHA3/FEAT_SHA512/
+ * FEAT_SM3/FEAT_SM4/FEAT_PAuth (Qualcomm Kryo 485 on nabu).
+ *
+ * The implementation lives in osfmk/arm64/nabu_v82_emul.c.
+ */
+
+#ifndef _OSFMK_ARM64_NABU_V82_EMUL_H_
+#define _OSFMK_ARM64_NABU_V82_EMUL_H_
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#include <mach/arm/thread_status.h>
+#include <pexpert/arm64/board_config.h>
+
+__BEGIN_DECLS
+
+/*
+ * Emulate one instruction that trapped with ESR.EC == ESR_EC_UNCATEGORIZED
+ * because the current CPU does not implement it.
+ *
+ * Called from sleh_synchronous() before the undefined-instruction handling.
+ * On success the saved PC has been advanced by one instruction and the saved
+ * state (and, for SIMD&FP instructions, the saved vector state in the
+ * exception frame) already holds the emulated result, so the caller only has
+ * to resume the context.
+ *
+ * Returns false when the faulting instruction is not one of the emulated
+ * encodings; the caller must then take the pre-existing fatal path.
+ */
+#if defined(ARM64_BOARD_CONFIG_NABU)
+extern bool nabu_v82_emul_sync_exception(arm_context_t *context, uint64_t esr);
+#else
+static inline bool
+nabu_v82_emul_sync_exception(arm_context_t *context, uint64_t esr)
+{
+	(void)context;
+	(void)esr;
+	return false;
+}
+#endif /* ARM64_BOARD_CONFIG_NABU */
+
+__END_DECLS
+
+#endif /* _OSFMK_ARM64_NABU_V82_EMUL_H_ */
