+#if defined(NABU)
+/* The cold secondary walks TTBR1 with caches disabled. Publish all valid
+ * table pages, including dynamically allocated descendants, not mapped data.
+ * This target's ARM_TT_ROOT is L1; L3 entries are leaves even when type == 3.
+ * Kernel table pages are not reclaimed during this initial CPU bring-up.
+ */
+static void
+nabu_publish_cpu_translation_tables(pmap_paddr_t root, unsigned level)
+{
+	tt_entry_t *table = (tt_entry_t *)phystokv(root);
+	if (level < 3) {
+		for (unsigned index = 0; index < TTE_PGENTRIES; index++) {
+			tt_entry_t entry = table[index];
+			if ((entry & (ARM_TTE_VALID | ARM_TTE_TYPE_MASK)) ==
+			    (ARM_TTE_VALID | ARM_TTE_TYPE_TABLE)) {
+				nabu_publish_cpu_translation_tables(entry & ARM_TTE_TABLE_MASK, level + 1);
+			}
+		}
+	}
+	CleanPoC_DcacheRegion_Force((vm_offset_t)table, ARM_PGBYTES);
+}
+#endif /* NABU */
+
 #if __ARM_KERNEL_PROTECT__
 extern void exc_vectors_table;
 #endif /* __ARM_KERNEL_PROTECT__ */
