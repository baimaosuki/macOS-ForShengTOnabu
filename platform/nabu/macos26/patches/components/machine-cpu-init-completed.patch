+
+// Match the Apple CPU driver's registration barrier. ml_processor_register() on
+// this XNU calls processor_boot() itself; its return alone does not complete the
+// scheduler's global CPU setup. The final successful registration invokes the
+// original completion routine, which waits for every processor's first startup.
+void ArmCpu::registrationReturned (void)
+{
+  unsigned expected = static_cast<unsigned> (ml_get_max_cpu_number ()) + 1;
+  unsigned registered = __atomic_add_fetch (&armcpu_registration_count, 1U, __ATOMIC_ACQ_REL);
+  if (registered != expected) { return; }
+  for (unsigned cpu = 0; cpu < expected; cpu++) {
+    if (__atomic_load_n (&armcpu_smp_fail[cpu], __ATOMIC_ACQUIRE) != 0 ||
+        __atomic_load_n (&armcpu_smp_psci_rc[cpu], __ATOMIC_ACQUIRE) != 0) { return; }
+  }
+  // Exactly one registration can observe the final count. Do not set scheduler
+  // internals: its own completion path checks and waits for real CPU startup.
+  ml_cpu_init_completed ();
+  IOService::publishResource (gIOAllCPUInitializedKey, kOSBooleanTrue);
+  __atomic_store_n (&armcpu_registration_complete, 1U, __ATOMIC_RELEASE);
 }
 
