+static void refreshSecondaryState (unsigned cpu)
+{
+  uintptr_t record = reinterpret_cast<uintptr_t> (nabu_secondary_boot_state[cpu]);
+  __asm__ volatile ("dsb sy\n\tdc ivac, %0\n\tdsb sy\n\tisb" :: "r" (record) : "memory");
 }
 
