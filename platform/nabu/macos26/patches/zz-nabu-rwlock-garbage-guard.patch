+/*
+ * NABU: a prelinked kext can hand an rwlock entry point a pointer that is not a
+ * lock at all (AMFI's sysctl name string in the kext band, odd address).  The
+ * debug path panics on it, and the fast path then faults on an unaligned
+ * atomic.  Anything that cannot hold an lck_rw_t is dropped: a lock operation on
+ * kext text is meaningless, and letting it through stops the boot.
+ */
+static inline bool
+lck_rw_nabu_plausible(void *lock)
+{
+	uintptr_t address = (uintptr_t)lock;
+
+	if (address == 0 || (address & 0x3) != 0) {
+		return false;
+	}
+	if (address < 0xfffffe0000000000ULL) {
+		return false;
+	}
+	return true;
+}
+
 __abortlike
 static void
 __lck_rw_old_not_owned_panic(
@@ -680,6 +703,11 @@ lck_rw_dbg_assert_held_slow(void *lock, lck_rw_type_t type)
 	thread_t        self = current_thread();
 	rw_lock_debug_t rw_locks_held = &self->rw_lock_held;
 
+	if (!lck_rw_nabu_plausible(lock)) {
+		printf("NABU: %s: %p is not a lock, dropping\n", "lck_rw_dbg_assert_held_slow", lock);
+		return;
+	}
+
 	struct rw_lock_debug_entry *entry = find_lock_in_savedlocks(lock, rw_locks_held);
 	if (__probable(entry != NULL)) {
 		if ((type != LCK_RW_TYPE_SHARED && entry->rwlde_mode_count == -1) ||
@@ -816,6 +844,11 @@ lck_rw_dbg_remove_slow(void *lock, lck_rw_type_t type)
 	thread_t        self = current_thread();
 	rw_lock_debug_t rw_locks_held = &self->rw_lock_held;
 
+	if (!lck_rw_nabu_plausible(lock)) {
+		printf("NABU: %s: %p is not a lock, dropping\n", "lck_rw_dbg_remove_slow", lock);
+		return;
+	}
+
 	if (os_sub_overflow(rw_locks_held->rwld_locks_acquired, 1,
 	    &rw_locks_held->rwld_locks_acquired)) {
 		panic("RWLock too many unlocks, for thread %p", self);
@@ -1532,6 +1565,10 @@ __lck_rw_new_func
 void
 lck_rw_lock_shared(lck_rw_t *lck)
 {
+	if (!lck_rw_nabu_plausible(lck)) {
+		return;
+	}
+
 	__lck_rw_lock_shared(lck, LCK_RW_MODE_SLEEPABLE);
 }
 
@@ -1568,6 +1605,10 @@ __lck_rw_new_func
