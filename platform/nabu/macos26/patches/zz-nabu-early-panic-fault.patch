--- a/osfmk/kern/debug.c
+++ b/osfmk/kern/debug.c
@@ -1254,6 +1254,21 @@
 #pragma clang diagnostic pop
 
 #if SHENG
+	{
+		/* Early-panic visualisation.  Before the console exists a panic just
+		 * spins silently, so deliberately take a data abort on an unmapped
+		 * low-half address: sheng_mmu_sync_fault repaints the panel with
+		 * XNU=3 and FAR = panic_caller & 0x0000fffffffffff8, which names the
+		 * caller exactly.  A load is used rather than brk because brk leaves
+		 * FAR UNKNOWN. */
+		extern volatile uint32_t sheng_bootstrap_capture_enabled;
+		if (sheng_bootstrap_capture_enabled &&
+		    panic_caller < 0x0000FFFFFFFFFFFFULL) {
+			volatile uint64_t *probe = (volatile uint64_t *)(uintptr_t)
+			    (panic_caller & 0x0000FFFFFFFFFFF8ULL);
+			(void)*probe;
+		}
+	}
 	char sheng_panic_message[4096];
 	va_list sheng_panic_args;
 	va_copy(sheng_panic_args, *panic_args);
