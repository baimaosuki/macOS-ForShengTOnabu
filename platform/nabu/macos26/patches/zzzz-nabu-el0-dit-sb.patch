@@ -0,0 +1,32 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+#ifndef NABU_EL0_SYSREG_H
+#define NABU_EL0_SYSREG_H
+#include <stdint.h>
+#include <stdbool.h>
+/* Narrow compatibility for unavailable FEAT_DIT and FEAT_SB. DIT remains
+ * effectively disabled: no hardware timing property or capability is claimed.
+ * MRS returns only that actual state; writes cannot enable missing hardware.
+ * A missing speculation barrier callback must never retire an SB instruction.
+ */
+static inline bool
+nabu_el0_sysreg_step(uint32_t op, uint64_t *value, bool *write, void (*barrier)(void))
+{
+    if ((op & 0xffffffe0U) == 0xd53b42a0U) { /* MRS Xt, DIT */
+        *value = 0;
+        *write = true;
+        return true;
+    }
+    if ((op & 0xffffffe0U) == 0xd51b42a0U || /* MSR DIT, Xt (including XZR) */
+        (op & 0xfffff0ffU) == 0xd503405fU) { /* MSR DIT, #imm4 */
+        *write = false;
+        return true;
+    }
+    if (op == 0xd50330ffU) { /* SB, no operands */
+        if (!barrier) return false;
+        barrier();
+        *write = false;
+        return true;
+    }
+    return false;
+}
+#endif
