--- a/osfmk/arm64/cpu.c
+++ b/osfmk/arm64/cpu.c
@@ -86,6 +86,24 @@
 vm_address_t   start_cpu_paddr;
 #endif
 
+#if defined(NABU)
+/* A cold CPU walks these pages with caches disabled. Publish table pages,
+ * not their data mappings; ARM_TT_ROOT is L1 and level3 entries are leaves. */
+static void
+nabu_clean_translation_table(pmap_paddr_t physical, unsigned level)
+{
+    tt_entry_t *table = (tt_entry_t *)phystokv(physical);
+    if (level < 3) {
+        for (unsigned i = 0; i < TTE_PGENTRIES; ++i) {
+            tt_entry_t entry = table[i];
+            if ((entry & (ARM_TTE_VALID | ARM_TTE_TYPE_MASK)) == (ARM_TTE_VALID | ARM_TTE_TYPE_TABLE))
+                nabu_clean_translation_table(entry & ARM_TTE_TABLE_MASK, level + 1);
+        }
+    }
+    CleanPoC_DcacheRegion_Force((vm_offset_t)table, ARM_PGBYTES);
+}
+#endif
+
